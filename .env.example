# ============================================================================
# STICKER VERSE — Environment Configuration Template
# ============================================================================

# Supabase Project Credentials
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-publishable-key-here

# Groq AI API Key (Used for AI Bulk Sticker Dump & Print Batch Optimizer)
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

# Note:
# Never put your Supabase service_role secret key in Vite environment variables.
# The application uses PostgreSQL Row Level Security (RLS) and Security Definer
# RPC functions (create_pack_order, create_print_batch_with_allocations) to
# safely execute privileged transactional writes with the publishable anon key.
